{
  "name": "dsh-easy-paint",
  "version": "0.5.5",
  "description": "用本机 ComfyUI 生成图片的插件，支持 Qwen-Image / SDXL / Z-Image 三套架构切换",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "comfyui",
    "qwen-image",
    "sdxl",
    "z-image",
    "text-to-image",
    "image-editing",
    "lora"
  ],
  "homepage": "https://github.com/Hits-pano/dsh-easy-paint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hits-pano/dsh-easy-paint.git"
  },
  "bugs": {
    "url": "https://github.com/Hits-pano/dsh-easy-paint/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "docs/*",
    "screenshots.json",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
